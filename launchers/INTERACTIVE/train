# Run a benchmark on the current node, without srun.
# Usage: launchers/INTERACTIVE/train <config> [hydra overrides]
# e.g.   launchers/INTERACTIVE/train o96 model.num_channels=256

root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)

config=${1:?usage: $0 <config> [bin/train options] [hydra overrides]}
shift

source ${AIFS_ENV:-$root_dir/env/ecmwf-ag.sh}
set -eu

$root_dir/bin/train --interactive --config=$config "$@"
