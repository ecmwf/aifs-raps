"""Summarise one or more AIFS-RAPS training run directories as CSV.

Usage: aifs-jobinfo <rundir> [<rundir> ...]

Reads config.yaml and out.txt, which bin/train writes to each run directory.
"""

import csv
import re
import sys
from pathlib import Path

import yaml

FIELDS = [
    "Config", "NodeCount", "GPUsPerNode", "GPUCount", "GPUsPerModel", "BatchSizePerModel",
    "GlobalBatchSize", "EnsembleSizePerDevice", "NumChannels", "Model", "SourceRes", "Graph",
    "Precision", "TrainBatchLimit", "MaxEpochs", "NumWorkers", "Dataset", "Success",
    "StartTime", "EndTime", "TrainingEpochTimeS", "AvgTrainingThroughput", "PeakGPUMem", "rundir",
]


def get(cfg, path, default=""):
    for key in path.split("."):
        if not isinstance(cfg, dict) or key not in cfg:
            return default
        cfg = cfg[key]
    return cfg


def table_cells(text, name):
    """Return the cells after `name` in the last markdown table row that contains `name`."""
    rows = [line for line in text.splitlines() if line.lstrip().startswith("|") and f" {name} " in line]
    if not rows:
        return []
    cells = [cell.strip() for cell in rows[-1].strip().strip("|").split("|")]
    return cells[cells.index(name) + 1 :]


def profiler_value(text, name, column=0):
    """Return a value from the benchmark profiler tables in out.txt."""
    cells = table_cells(text, name)
    return cells[column] if len(cells) > column else ""


def last_match(pattern, text):
    matches = re.findall(pattern, text, re.MULTILINE)
    return matches[-1].strip() if matches else ""


def jobinfo(rundir):
    rundir = Path(rundir)
    cfg = yaml.safe_load((rundir / "config.yaml").read_text()) if (rundir / "config.yaml").exists() else {}
    out = (rundir / "out.txt").read_text(errors="ignore") if (rundir / "out.txt").exists() else ""

    nodes = int(get(cfg, "system.hardware.num_nodes", 1) or 1)
    gpn = int(get(cfg, "system.hardware.num_gpus_per_node", 1) or 1)
    gpm = int(get(cfg, "system.hardware.num_gpus_per_model", 1) or 1)
    bpm = int(get(cfg, "dataloader.batch_size.training", 1) or 1)
    model_target = get(cfg, "model.processor._target_", "")

    return {
        "Config": rundir.name.split("_")[0],
        "NodeCount": nodes,
        "GPUsPerNode": gpn,
        "GPUCount": nodes * gpn,
        "GPUsPerModel": gpm,
        "BatchSizePerModel": bpm,
        "GlobalBatchSize": bpm * max(nodes * gpn // gpm, 1),
        "EnsembleSizePerDevice": get(cfg, "training.ensemble_size_per_device", 0),
        "NumChannels": get(cfg, "model.num_channels"),
        "Model": model_target.split(".")[-1],
        "SourceRes": get(cfg, "data.resolution"),
        "Graph": Path(str(get(cfg, "system.input.graph"))).name,
        "Precision": get(cfg, "training.precision"),
        "TrainBatchLimit": get(cfg, "dataloader.limit_batches.training"),
        "MaxEpochs": get(cfg, "training.max_epochs"),
        "NumWorkers": get(cfg, "dataloader.num_workers.training"),
        "Dataset": Path(str(get(cfg, "system.input.dataset"))).name,
        "Success": int("Exit code: 0" in out),
        "StartTime": last_match(r"^Start time: (\d+)", out),
        "EndTime": last_match(r"^End time: (\d+)", out),
        "TrainingEpochTimeS": profiler_value(out, "run_training_epoch"),  # | name | total time | ...
        "AvgTrainingThroughput": profiler_value(out, "training_avg_throughput"),
        "PeakGPUMem": profiler_value(out, "Allocated memory", column=1).replace(" ", ""),  # | name | current | peak | ...
        "rundir": str(rundir),
    }


def main():
    if len(sys.argv) < 2:
        print(__doc__, file=sys.stderr)
        sys.exit(1)
    writer = csv.DictWriter(sys.stdout, fieldnames=FIELDS)
    writer.writeheader()
    for rundir in sys.argv[1:]:
        writer.writerow(jobinfo(rundir))


if __name__ == "__main__":
    main()
