# which can be obtained at http://www.apache.org/licenses/LICENSE-2.0.
#
# In applying this licence, ECMWF does not waive the privileges and immunities
# granted to it by virtue of its status as an intergovernmental organisation
# nor does it submit to any jurisdiction.

#
# Batch system independent script to run an AIFS inference benchmark.
# The python environment (anemoi-inference etc.) must already be active, or
# set AIFS_EXEC to run it in a container (see bin/lib/exec.sh).
#
# Usage: inf (-C <checkpoint> | --train-rundir <dir>) [options] [-- <config overrides>]
#
# Author: Cathal O'Brien (ECMWF) 13-Nov-2024 : Initial version

set -euo pipefail

cmd=$(basename $0)
root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source $root_dir/bin/lib/exec.sh

function usage
{
    cat <<EOF
Usage: $cmd (-C <checkpoint> | --train-rundir <dir>) [options] [-- <config overrides>]

Options:
  -C, --checkpoint <path>    Inference checkpoint (inference-*.ckpt), or a directory that contains
                             one, e.g. a bin/train run directory (uses the newest inference-last.ckpt)
  --train-rundir <dir>       Same as --checkpoint <dir>
  -T, --lead-time <hours>    Forecast length in hours (default: 240)
  -I, --input <input>        'dummy' (synthetic fields, default), a GRIB file or a zarr dataset
  -d, --date <date>          Initial date, e.g. 2023-06-01T12:00:00 (default: 2023-01-01T00:00:00)
  -O, --output <type>        grib (default), netcdf, zarr or none
  -W, --writers <n>          Number of parallel output writer processes. 0 (default) disables parallel output
  -p, --precision <p>        Inference precision, e.g. bf16 or 16-mixed (default: bf16). 'checkpoint' uses
                             the training precision. fp16 can overflow to NaN with the dummy input
  --chunks <n>               Split the mappers and processor into <n> chunks to use less memory (default: 1)
  -D, --devices <n>          GPUs to shard the model over with --interactive (default: 1)
  --interactive              Do not use srun, even inside a SLURM allocation
  -J, --jobname <name>       Name used in the run directory (default: \$SLURM_JOB_NAME or 'aifs')
  --profile                  Enable the anemoi-inference profiler
  --nsys                     Run under nsys (or rocprofv3 on AMD)
  --dryrun                   Print the inference config and exit
  -h, --help                 Show this message

Everything after '--' is passed to 'anemoi-inference run' as config overrides,
e.g. 'write_initial_state=false'.

Under SLURM the model is sharded over all tasks of the job step.

Environment:
  AIFS_OUTPUT_DIR            Root of the run directories (required)
  AIFS_EXEC                  Prefix for the inference command, e.g. 'apptainer exec --nv image.sif'
  AIFS_TOOL_EXEC             Prefix for the helper steps outside srun (default: \$AIFS_EXEC)
  AIFS_SRUN_ARGS             Extra srun options, e.g. '--container-image=image.sqsh'
EOF
}

checkpoint=""
train_rundir=""
lead_time=240
input="dummy"
date="2023-01-01T00:00:00"
output="grib"
writers=0
precision="bf16"
chunks=1
devices=1
interactive=0
jobname=${SLURM_JOB_NAME:-aifs}
profile=0
use_nsys=0
dryrun=0

while [[ $# -gt 0 ]]; do
    case "$1" in
    -C|--checkpoint) checkpoint=$2; shift 2;;
    --checkpoint=*) checkpoint=${1#*=}; shift;;
    --train-rundir) train_rundir=$2; shift 2;;
    --train-rundir=*) train_rundir=${1#*=}; shift;;
    -T|--lead-time) lead_time=$2; shift 2;;
    --lead-time=*) lead_time=${1#*=}; shift;;
    -I|--input) input=$2; shift 2;;
    --input=*) input=${1#*=}; shift;;
    -d|--date) date=$2; shift 2;;
    --date=*) date=${1#*=}; shift;;
    -O|--output) output=$2; shift 2;;
    --output=*) output=${1#*=}; shift;;
    -W|--writers) writers=$2; shift 2;;
    --writers=*) writers=${1#*=}; shift;;
    -p|--precision) precision=$2; shift 2;;
    --precision=*) precision=${1#*=}; shift;;
    --chunks) chunks=$2; shift 2;;
    --chunks=*) chunks=${1#*=}; shift;;
    -D|--devices) devices=$2; shift 2;;
    --devices=*) devices=${1#*=}; shift;;
    --interactive) interactive=1; shift;;
    -J|--jobname) jobname=$2; shift 2;;
    --jobname=*) jobname=${1#*=}; shift;;
    --profile) profile=1; shift;;
    --nsys) use_nsys=1; shift;;
    --dryrun) dryrun=1; shift;;
    -h|--help) usage; exit 0;;
    --) shift; break;;
    *) echo "$cmd: (Error) unknown argument '$1'" >&2; usage >&2; exit 1;;
    esac
done
overrides=("$@")

# --- checks -----------------------------------------------------------------

require_cmd anemoi-inference
if [[ -z ${AIFS_OUTPUT_DIR:-} ]]; then
    echo "$cmd: (Error) AIFS_OUTPUT_DIR is not set" >&2; exit 1
fi

if [[ -z $checkpoint ]] && [[ -z $train_rundir ]]; then
    echo "$cmd: (Error) give a checkpoint with --checkpoint or --train-rundir" >&2; exit 1
fi
if [[ -z $checkpoint ]]; then
    checkpoint=$train_rundir
fi
if [[ -d $checkpoint ]]; then
    # A directory: a bin/train run directory, its checkpoint directory, or one run id in it
    dir=$checkpoint
    checkpoint=$(ls -t $dir/inference-last.ckpt $dir/*/inference-last.ckpt \
                       $dir/train-outputs/checkpoint/*/inference-last.ckpt 2>/dev/null | head -n 1 || :)
    if [[ -z $checkpoint ]]; then
        echo "$cmd: (Error) no inference-last.ckpt found in '$dir'" >&2; exit 1
    fi
    echo "Using checkpoint $checkpoint"
fi
if [[ ! -f $checkpoint ]]; then
    echo "$cmd: (Error) checkpoint '$checkpoint' not found" >&2; exit 1
fi
checkpoint=$(realpath $checkpoint)

case $output in
    grib|netcdf|zarr|none) ;;
    *) echo "$cmd: (Error) unknown output '$output'. Use grib, netcdf, zarr or none" >&2; exit 1;;
esac
if [[ $writers -gt 0 ]] && [[ $output == "none" ]]; then
    echo "$cmd: (Error) --writers needs an output. Remove '--output=none'" >&2; exit 1
fi

# --- resources --------------------------------------------------------------

in_slurm=0
if [[ -n ${SLURM_JOB_ID:-} ]] && [[ $interactive -eq 0 ]]; then
    in_slurm=1
fi

launcher=()
if [[ $in_slurm -eq 1 ]]; then
    num_nodes=${SLURM_NNODES:-1}
    tasks_per_node=${SLURM_NTASKS_PER_NODE:-1}
    tasks_per_node=${tasks_per_node%%(*} # e.g. '4(x2)' -> '4'
    devices=$((num_nodes * tasks_per_node))
    # The parallel runner calls 'scontrol' to find the master node if MASTER_ADDR is not set.
    # 'scontrol' is often not in a container, so find it here, on the host.
    if [[ -z ${MASTER_ADDR:-} ]] && command -v scontrol > /dev/null; then
        export MASTER_ADDR=$(scontrol show hostnames "${SLURM_JOB_NODELIST:-$SLURM_NODELIST}" | head -n 1)
    fi
    launcher=(srun --nodes=$num_nodes --ntasks-per-node=$tasks_per_node
              --gpus-per-node=$tasks_per_node --cpus-per-task=${SLURM_CPUS_PER_TASK:-1} -K1 "${srun_args[@]}")
else
    num_nodes=1
fi

# --- run directory ----------------------------------------------------------

jobid=${SLURM_JOB_ID:-$$}
ckpt_name=$(basename $checkpoint .ckpt)
rundir=$AIFS_OUTPUT_DIR/inf/${ckpt_name}_${num_nodes}N_${devices}g_${lead_time}h_${output}_${writers}w.${jobname}-${jobid}
mkdir -p $rundir/logs

# --- inference config -------------------------------------------------------

config=$rundir/inf.yaml
{
    echo "checkpoint: $checkpoint"
    echo "lead_time: $lead_time"
    echo "date: $date"
    if [[ $precision != "checkpoint" ]]; then
        echo "precision: $precision"
    fi
    echo "use_profiler: $([[ $profile -eq 1 ]] && echo true || echo false)"

    # Model sharding: the parallel runner splits the model over all devices
    if [[ $devices -gt 1 ]]; then
        if [[ $in_slurm -eq 1 ]]; then
            echo "runner: parallel"
        else
            echo "runner:"
            echo "  parallel:"
            echo "    cluster:"
            echo "      manual: $devices"
        fi
    fi

    case $input in
        dummy) echo "input: dummy";;
        *.zarr) echo "input:"; echo "  dataset: $(realpath $input)";;
        *) echo "input:"; echo "  grib: $(realpath $input)";;
    esac
} > $config

out_path=""
inner_output=()
case $output in
    none)
        inner_output=("none:");;
    grib)
        out_path=$rundir/aifs_out.grib
        sed "s#\$AIFS_RAPS_ROOT#$root_dir#g" $root_dir/etc/aifs/inf/grib-templates/templates.yaml > $rundir/grib_templates.yaml
        inner_output=("grib:" "  path: $out_path" "  templates:" "    - samples:" "        index_path: $rundir/grib_templates.yaml");;
    netcdf)
        out_path=$rundir/aifs_out.nc
        inner_output=("netcdf:" "  path: $out_path");;
    zarr)
        out_path=$rundir/aifs_out.zarr
        inner_output=("zarr:" "  store: $out_path");;
esac

{
    echo "output:"
    if [[ $writers -gt 0 ]]; then
        # Parallel output: forked writer processes write the fields, each to its own file
        echo "  parallel:"
        echo "    num_writers: $writers"
        echo "    output:"
        printf '      %s\n' "${inner_output[@]}"
    else
        printf '  %s\n' "${inner_output[@]}"
    fi
} >> $config

if [[ $dryrun -eq 1 ]]; then
    cat $config
    rm -rf $rundir
    exit 0
fi

profiler=()
if [[ $use_nsys -eq 1 ]]; then
    if in_env sh -c 'command -v nsys' > /dev/null 2>&1; then
        profiler=(nsys profile -o $rundir/nsys/out.%q{SLURM_PROCID} -f true --cuda-memory-usage true --)
    elif in_env sh -c 'command -v rocprofv3' > /dev/null 2>&1; then
        profiler=(rocprofv3 --hip-trace -d $rundir/rocprof --)
    else
        echo "$cmd: (Error) --nsys given but neither nsys nor rocprofv3 found" >&2; exit 1
    fi
    mkdir -p $rundir/nsys
fi

export ANEMOI_INFERENCE_NUM_CHUNKS=$chunks
# Triton keeps compiled kernels in ~/.triton/cache. If $HOME is on a network file system,
# many ranks that write the same kernel at the same time can fail with "Stale file handle".
# Use node-local storage. Each job then compiles its kernels again.
export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-${TMPDIR:-/tmp}/triton-cache}
export NCCL_DEBUG=${NCCL_DEBUG:-INFO}
export NCCL_DEBUG_SUBSYS=${NCCL_DEBUG_SUBSYS:-INIT,ENV,NET,GRAPH,TUNING}
export NCCL_DEBUG_FILE=$rundir/logs/nccl.%h.%p

run_cmd=(anemoi-inference run $config "${overrides[@]}")
echo "${launcher[*]} ${run_exec[*]} ${profiler[*]} ${run_cmd[*]}" > $rundir/run_cmd.txt
in_env python -m pip freeze > $rundir/python_env.txt 2>/dev/null || :
(in_env nvidia-smi || in_env rocm-smi) > $rundir/gpu.txt 2>&1 || :
printenv | sort > $rundir/env.txt

ulimit -c 0 # disable core dumps

cd $rundir
echo "Running inference on $num_nodes node(s), $devices GPU(s). rundir=$rundir"
exit_code=0
echo "Start time: $(date +%s)" | tee $rundir/out.txt
"${launcher[@]}" "${run_exec[@]}" "${profiler[@]}" "${run_cmd[@]}" 2>&1 | tee -a $rundir/out.txt || exit_code=$?
echo "End time: $(date +%s)" | tee -a $rundir/out.txt
echo "Exit code: $exit_code" | tee -a $rundir/out.txt

if [[ -n $out_path ]]; then
    du -shc ${out_path%.*}* 2>/dev/null | tee $rundir/output_size.txt || :
fi

exit $exit_code
