#
# Batch system independent script to run an AIFS training benchmark.
# The python environment (anemoi-training etc.) must already be active.
#
# Usage: train -c <config> [options] [-- <hydra overrides>]
#
# Author: Cathal O'Brien (ECMWF) 13-Nov-2024 : Initial version

set -euo pipefail

cmd=$(basename $0)
root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

function usage
{
    cat <<EOF
Usage: $cmd -c <config> [options] [-- <hydra overrides>]

Options:
  -c, --config <name>   Config name in $root_dir/configs (e.g. o96, n320, o1280)
  -J, --jobname <name>  Name used in the run directory (default: \$SLURM_JOB_NAME or 'aifs')
  --interactive         Do not use srun, even inside a SLURM allocation
  --no-profile          Run 'anemoi-training train' instead of 'anemoi-training profile'
  --nsys                Run under nsys (or rocprofv3 on AMD)
  --dryrun              Print the resolved config and exit
  -h, --help            Show this message

Everything after '--' is passed to anemoi-training as hydra overrides,
e.g. 'model.num_channels=512 dataloader.limit_batches.training=10'.

Environment:
  AIFS_DATA_DIR         Directory containing the input zarr datasets (required)
  AIFS_OUTPUT_DIR       Root of the run directories (required)
  AIFS_GRAPH_DIR        Graph cache (default: \$AIFS_OUTPUT_DIR/graphs)
  AIFS_GPUS_PER_NODE    GPUs per node (default: \$SLURM_GPUS_PER_NODE or all visible GPUs)
EOF
}

config=""
jobname=${SLURM_JOB_NAME:-aifs}
interactive=0
mode="profile"
use_nsys=0
dryrun=0

while [[ $# -gt 0 ]]; do
    case "$1" in
    -c|--config) config=$2; shift 2;;
    --config=*) config=${1#*=}; shift;;
    -J|--jobname) jobname=$2; shift 2;;
    --jobname=*) jobname=${1#*=}; shift;;
    --interactive) interactive=1; shift;;
    --no-profile) mode="train"; shift;;
    --nsys) use_nsys=1; shift;;
    --dryrun) dryrun=1; shift;;
    -h|--help) usage; exit 0;;
    --) shift; break;;
    *) echo "$cmd: (Error) unknown argument '$1'" >&2; usage >&2; exit 1;;
    esac
done
hydra_args=("$@")

# --- checks -----------------------------------------------------------------

if [[ -z $config ]]; then
    echo "$cmd: (Error) no config given" >&2; usage >&2; exit 1
fi
config_dir=$root_dir/configs
if [[ ! -f $config_dir/$config.yaml ]]; then
    echo "$cmd: (Error) config '$config_dir/$config.yaml' not found" >&2; exit 1
fi
if ! command -v anemoi-training > /dev/null; then
    echo "$cmd: (Error) 'anemoi-training' not found. Activate your python environment first" >&2; exit 1
fi
for var in AIFS_DATA_DIR AIFS_OUTPUT_DIR; do
    if [[ -z ${!var:-} ]]; then
        echo "$cmd: (Error) $var is not set" >&2; exit 1
    fi
done
export AIFS_GRAPH_DIR=${AIFS_GRAPH_DIR:-$AIFS_OUTPUT_DIR/graphs}
mkdir -p $AIFS_GRAPH_DIR

# --- resources --------------------------------------------------------------

in_slurm=0
if [[ -n ${SLURM_JOB_ID:-} ]] && [[ $interactive -eq 0 ]]; then
    in_slurm=1
fi

if [[ -z ${AIFS_GPUS_PER_NODE:-} ]]; then
    if [[ -n ${SLURM_GPUS_PER_NODE:-} ]]; then
        AIFS_GPUS_PER_NODE=${SLURM_GPUS_PER_NODE##*:} # handles 'gpu:4' and '4'
    elif command -v nvidia-smi > /dev/null; then
        AIFS_GPUS_PER_NODE=$(nvidia-smi -L | wc -l)
    elif command -v rocm-smi > /dev/null; then
        AIFS_GPUS_PER_NODE=$(rocm-smi --showid | grep -c "^GPU\[")
    else
        AIFS_GPUS_PER_NODE=1
    fi
fi
num_nodes=1
if [[ $in_slurm -eq 1 ]]; then
    num_nodes=${SLURM_NNODES:-1}
fi
# The configs read the node and GPU counts from these variables
export SLURM_GPUS_PER_NODE=$AIFS_GPUS_PER_NODE
export SLURM_NNODES=$num_nodes

launcher=()
if [[ $in_slurm -eq 1 ]]; then
    launcher=(srun --nodes=$num_nodes --ntasks-per-node=$AIFS_GPUS_PER_NODE
              --gpus-per-node=$AIFS_GPUS_PER_NODE --cpus-per-task=${SLURM_CPUS_PER_TASK:-1} -K1)
fi

# --- run directory ----------------------------------------------------------

jobid=${SLURM_JOB_ID:-$$}
rundir=$AIFS_OUTPUT_DIR/train/${config}_${num_nodes}N_${AIFS_GPUS_PER_NODE}gpn.${jobname}-${jobid}
mkdir -p $rundir/logs

run_cmd=(anemoi-training $mode --config-dir=$config_dir --config-name=$config
         hydra.run.dir=$rundir/hydra system.output.root=$rundir/train-outputs
         "${hydra_args[@]}")

# Save the resolved config. This also checks the config before we allocate GPUs.
anemoi-training train --config-dir=$config_dir --config-name=$config \
    system.output.root=$rundir/train-outputs "${hydra_args[@]}" \
    --cfg job --resolve > $rundir/config.yaml

if [[ $dryrun -eq 1 ]]; then
    cat $rundir/config.yaml
    rm -rf $rundir
    exit 0
fi

profiler=()
if [[ $use_nsys -eq 1 ]]; then
    if command -v nsys > /dev/null; then
        trace_file=$root_dir/etc/aifs/profiling/nsys/PythonFunctionsTrace/anemoi.json
        profiler=(nsys profile -o $rundir/nsys/out.%q{SLURM_PROCID} -f true --cuda-memory-usage true
                  --python-functions-trace=$trace_file --)
    elif command -v rocprofv3 > /dev/null; then
        profiler=(rocprofv3 --hip-trace -d $rundir/rocprof --)
    else
        echo "$cmd: (Error) --nsys given but neither nsys nor rocprofv3 found" >&2; exit 1
    fi
    mkdir -p $rundir/nsys
fi

export HYDRA_FULL_ERROR=1
export NCCL_DEBUG=${NCCL_DEBUG:-INFO}
export NCCL_DEBUG_SUBSYS=${NCCL_DEBUG_SUBSYS:-INIT,ENV,NET,GRAPH,TUNING}
export NCCL_DEBUG_FILE=$rundir/logs/nccl.%h.%p

echo "${launcher[*]} ${profiler[*]} ${run_cmd[*]}" > $rundir/run_cmd.txt
pip freeze > $rundir/python_env.txt 2>/dev/null || :
python -c 'import torch; print(torch.__config__.show())' > $rundir/pytorch_config.txt 2>&1 || :
(nvidia-smi || rocm-smi) > $rundir/gpu.txt 2>&1 || :
printenv | sort > $rundir/env.txt

ulimit -c 0 # disable core dumps

echo "Running '$config' on $num_nodes node(s) x $AIFS_GPUS_PER_NODE GPU(s). rundir=$rundir"
exit_code=0
echo "Start time: $(date +%s)" | tee $rundir/out.txt
"${launcher[@]}" "${profiler[@]}" "${run_cmd[@]}" 2>&1 | tee -a $rundir/out.txt || exit_code=$?
echo "End time: $(date +%s)" | tee -a $rundir/out.txt
echo "Exit code: $exit_code" | tee -a $rundir/out.txt

# --- post processing --------------------------------------------------------

graph=$(python -c "import sys, yaml; print(yaml.safe_load(open(sys.argv[1]))['system']['input']['graph'])" $rundir/config.yaml 2>/dev/null || :)
if [[ -f $graph ]]; then
    anemoi-graphs describe $graph > $rundir/graph.txt 2>&1 || :
fi

$root_dir/bin/aifs-jobinfo $rundir > $rundir/jobinfo.csv || :
echo "Results: $rundir/jobinfo.csv"

exit $exit_code
